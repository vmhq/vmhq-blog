# Posts API (api/server.ts) configuration.
# Copy to .env — docker compose picks it up automatically;
# for a local run: bun run api (loads .env via Bun).

# Bearer token AI agents must send in the Authorization header. Generate with: openssl rand -hex 32
BLOG_API_TOKEN=

# Optional overrides (defaults shown).
#SITE_URL=https://blog.vmhq.cl
#PORT=8787

# Where posts/images are read from and written to.
# Local dev default: ./data (gitignored, seeded from posts/ and
# public/images/posts/ on first run). Docker sets this to /data, backed by
# the posts_data named volume, and does not need it set here.
#DATA_DIR=./data
